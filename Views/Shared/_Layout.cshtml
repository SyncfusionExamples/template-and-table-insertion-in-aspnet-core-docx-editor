<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Base Path Configuration for GitHub Repo / Path Mapping -->
    <base href="/template-and-table-insertion-in-aspnet-core-docx-editor" />
    <title>@ViewData["Title"] - AspNetCoreSample</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AspNetCoreSample.styles.css" asp-append-version="true" />
    <!-- Syncfusion ASP.NET Core controls styles -->
<link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/34.2.8/tailwind3.css" />
<!-- Syncfusion ASP.NET Core controls scripts -->
<script src="https://cdn.syncfusion.com/ej2/34.2.8/dist/ej2.min.js"></script>
    
</head>
<body>
    <div class="container-fluid" style="height: 100%; width: 100%; padding: 0; margin: 0;">
        @* <main role="main" class="pb-3"> *@
            @RenderBody()
        @* </main> *@
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
    console.log(location.origin + '/../../locale/de-DE.json');
        var ajax = new ej.base.Ajax(location.origin + '/../../locale/de-DE.json', 'GET', false);   //load the de json culture file 
        ajax.send().then((e) => {
            var loader = JSON.parse(e);

            ej.base.L10n.load(
                loader
            );
            ej.base.setCulture('de-De');     //Set the culture for the ASP.NET Core controls 
        });            
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- Syncfusion ASP.NET Core Script Manager -->
    <ejs-scripts></ejs-scripts>
</body>
</html>
